#!/usr/bin/env bash

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

REMOTE_NAME="$1"
ZERO_SHA="0000000000000000000000000000000000000000"
NEED_BUILD=0

function git_flow_parent() {
  local branch="$1"
  case "$branch" in
    main) printf "" ;;
    develop) printf "main" ;;
    feature/*|release/*) printf "develop" ;;
    hotfix/*) printf "main" ;;
    *) printf "__invalid__" ;;
  esac
}

function find_bun() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi
  if [ -x "${HOME}/.bun/bin/bun" ]; then
    printf "%s\n" "${HOME}/.bun/bin/bun"
    return 0
  fi
  return 1
}

function find_node() {
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi

  local candidate
  for candidate in /usr/bin/node /usr/local/bin/node "${HOME}/.volta/bin/node" "${HOME}/.local/share/fnm/aliases/default/bin/node"; do
    if [ -x "$candidate" ]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done

  local nvm_node
  nvm_node="$(ls -1d "${HOME}/.nvm/versions/node/"*/bin/node 2>/dev/null | sort -V | tail -n 1 || true)"
  if [ -n "$nvm_node" ] && [ -x "$nvm_node" ]; then
    printf "%s\n" "$nvm_node"
    return 0
  fi

  return 1
}

function run_build() {
  echo "pre-push: rodando build (next build)..." >&2

  local bun_bin
  if bun_bin="$(find_bun)"; then
    "$bun_bin" run build
    return 0
  fi

  local node_bin
  if ! node_bin="$(find_node)"; then
    echo "pre-push: bun/node não encontrado" >&2
    exit 1
  fi

  "$node_bin" ./node_modules/next/dist/bin/next build
}

function ensure_up_to_date() {
  local branch="$1"
  local local_sha="$2"
  local parent
  parent="$(git_flow_parent "$branch")"

  if [ "$parent" = "__invalid__" ]; then
    cat >&2 <<EOF
pre-push: BLOQUEADO — branch '$branch' não segue o git flow.

Use: main, develop, feature/*, release/* ou hotfix/*.
EOF
    exit 1
  fi

  if [ -z "$parent" ]; then
    return 0
  fi

  echo "pre-push: verificando se '$branch' contém '$REMOTE_NAME/$parent'..." >&2

  if ! git fetch --quiet "$REMOTE_NAME" "refs/heads/$parent" </dev/null; then
    local parent_ls
    if ! parent_ls="$(git ls-remote --heads "$REMOTE_NAME" "$parent")"; then
      echo "pre-push: não foi possível buscar '$parent' de '$REMOTE_NAME'" >&2
      exit 1
    fi
    if [ -z "$parent_ls" ]; then
      echo "pre-push: branch '$parent' não existe em '$REMOTE_NAME', nada a verificar" >&2
      return 0
    fi
    echo "pre-push: não foi possível buscar '$parent' de '$REMOTE_NAME'" >&2
    exit 1
  fi

  if ! git merge-base --is-ancestor FETCH_HEAD "$local_sha"; then
    cat >&2 <<EOF
pre-push: BLOQUEADO — '$branch' está atrás de '$REMOTE_NAME/$parent'.

Sua branch não contém todos os commits da branch pai.
Atualize-a antes de fazer push:

  git fetch $REMOTE_NAME
  git merge $REMOTE_NAME/$parent   # ou: git rebase $REMOTE_NAME/$parent

Depois faça o push novamente.
EOF
    exit 1
  fi

  echo "pre-push: '$branch' está atualizada com '$REMOTE_NAME/$parent'" >&2
}

push_lines=()
while read -r local_ref local_sha remote_ref remote_sha; do
  push_lines+=("$local_ref $local_sha $remote_ref $remote_sha")
done

for line in "${push_lines[@]}"; do
  read -r local_ref local_sha remote_ref remote_sha <<<"$line"

  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  NEED_BUILD=1

  case "$remote_ref" in
    refs/heads/*)
      ensure_up_to_date "${remote_ref#refs/heads/}" "$local_sha"
      ;;
  esac
done

if [ "$NEED_BUILD" -eq 0 ]; then
  exit 0
fi

run_build
exit 0
